# App
APP_NAME="Avatar"
APP_VERSION="0.1.0"
DEBUG=False

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/avatar"

# Redis
REDIS_URL="redis://localhost:6379/0"

# JWT
JWT_SECRET_KEY="change_this_to_a_minimum_32_character_random_string_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Storage
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
STORAGE_BUCKET_MEDIA="media"
STORAGE_BUCKET_KYC="kyc"

# Payments
RAZORPAY_KEY_ID="rzp_test_123"
RAZORPAY_KEY_SECRET="rzp_test_secret_123"

# Notifications
SMS_PROVIDER_KEY=""
FCM_SERVER_KEY=""

# Rate Limiting
OTP_RATE_LIMIT_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
